// RUN: not jawac check %s 2>&1 | FileCheck %s

// One run reports every syntax error: the parser skips the rest of a bad
// statement and carries on.

gawe utama() {
    // CHECK: error: expected `)` to close the argument list, found end of line
    // CHECK-NEXT: --> {{.*}}syntax.jw:[[@LINE+1]]:12
    tulis(1
    ayo x = 1

    // C-style logic is reported once; the rest of the line still parses.
    // CHECK: error: unexpected `&`; use `lan` for logic
    // CHECK-NOT: error: expected `{`
    yen x > 0 && x < 9 {
        tulis(x)
    }

    // CHECK: error: methods are not supported
    // CHECK: = note: call it as a function instead: `tambah(value, …)`
    x.tambah(1)

    // CHECK: error: expected `=` after the variable name, found end of line
    // CHECK: = note: every variable starts with a value, such as `ayo y = 0`
    ayo y
}

// CHECK: error: expected `{` to open a block, found end of line
// CHECK: = note: put the `{` on the same line
gawe liya()
{
}

// CHECK: error: could not compile `{{.*}}syntax.jw` because of 5 errors
