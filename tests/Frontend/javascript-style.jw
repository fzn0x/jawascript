// RUN: jawac --emit=mlir %s | FileCheck %s
// RUN: jawac --emit=mlir-opt %s | FileCheck %s --check-prefix=OPT

// Puteran `kanggo (wiwitan; syarat; pangowah)` dadi jawa.for sing region
// step-e ngemot pangowahe, mula `terusna` tetep nglakokake.
// CHECK-LABEL: func.func @utama()
// CHECK:   %[[I:.*]] = jawa.alloca "i" : !jawa.ptr<i64>
// CHECK:   jawa.store %{{.*}}, %[[I]]
// CHECK:   jawa.for {
// CHECK:     jawa.cmp lt
// CHECK:     jawa.condition
// CHECK:   } do {
// CHECK:     jawa.continue
// CHECK:   } step {
// CHECK:     jawa.load %[[I]]
// CHECK:     jawa.add
// CHECK:     jawa.store %{{.*}}, %[[I]]
// CHECK:     jawa.yield
// CHECK:   }

// Ukara cithakan iku rerantening sambungan, sing didadekake siji alokasi
// dening jawa-fuse-concat.
// OPT-LABEL: func.func @utama()
// OPT:   %[[N:.*]] = jawa.to_str %{{.*}} : i64
// OPT:   %[[S:.*]] = jawa.concat %{{.*}}, %[[N]], %{{.*}}
// OPT-NOT: jawa.concat
// OPT:   jawa.print %[[S]]
gawe utama() {
    kanggo (ayo i = 0; i < 3; i++) {
        yen (i == 1) {
            terusna;
        }
        tulis(`[${i}]`);
    }
}
