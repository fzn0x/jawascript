// RUN: jawac --emit=mlir-llvm %s | FileCheck %s --check-prefix=MLIR
// RUN: jawac --emit=llvm -O2 %s | FileCheck %s --check-prefix=IR

// Dialek LLVM: jeneng fungsi diwenehi `jw_`, lan deklarasi runtime.
// MLIR: llvm.func @jawa_rt_print_int(i64)
// MLIR: llvm.func internal @jw_tikel(%arg0: i64) -> i64
// MLIR: llvm.func @jw_utama()

// LLVM IR kanggo mesin iki, lawang mlebune diekspor kanggo runtime.
// IR: target triple
// IR: define {{.*}}void @jw_utama()
// IR: call void @jawa_rt_print_int(i64 42)

gawe tikel(n: wilangan) -> wilangan {
    bali n * 2
}

gawe utama() {
    tulis(tikel(21))
}
