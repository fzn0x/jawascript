// Saben kesalahan nalika mlaku nulis `gagal: …` menyang stderr, sawise
// ngetokake apa sing wis ditulis program, banjur metu kanthi status 1.

// RUN: split-file %s %t
// RUN: not jawac run %t/indeks.jw 2>&1 | FileCheck %s --check-prefix=INDEKS
// RUN: not jawac run %t/negatif.jw 2>&1 | FileCheck %s --check-prefix=NEGATIF
// RUN: not jawac run %t/kosong.jw 2>&1 | FileCheck %s --check-prefix=KOSONG
// RUN: not jawac run %t/nol.jw 2>&1 | FileCheck %s --check-prefix=NOL
// RUN: not jawac run -O0 %t/nol.jw 2>&1 | FileCheck %s --check-prefix=NOL
// RUN: not jawac run %t/maca.jw 2>&1 | FileCheck %s --check-prefix=MACA
// RUN: not jawac run %t/gagal.jw 2>&1 | FileCheck %s --check-prefix=GAGAL

//--- indeks.jw
gawe utama() {
    ayo larik = [1, 2, 3]
    tulis("sadurunge")
    tulis(larik[3])
}
// INDEKS: sadurunge
// INDEKS-NEXT: gagal: indeks 3 ora ana ing larik sing dawane 3

//--- negatif.jw
gawe utama() {
    ayo larik = [1, 2, 3]
    ayo i = -1
    larik[i] = 0
}
// NEGATIF: gagal: indeks -1 ora ana ing larik sing dawane 3

//--- kosong.jw
wujud Simpul {
    regane: wilangan
    sabanjure: Simpul
}

gawe utama() {
    ayo n = Simpul { regane: 1, sabanjure: kosong }
    tulis(n.sabanjure.regane)
}
// KOSONG: gagal: `kosong` ora duwe isi

//--- nol.jw
gawe bagi(a: wilangan, b: wilangan) -> wilangan {
    bali a / b
}

gawe utama() {
    tulis(bagi(1, 1))
    tulis(bagi(1, 0))
}
// NOL: 1
// NOL-NEXT: gagal: dibagi nol

//--- maca.jw
gawe utama() {
    tulis(wilangan("12abc"))
}
// MACA: gagal: "12abc" dudu wilangan

//--- gagal.jw
gawe utama() {
    gagal("ora bisa diterusake: " + 42)
}
// GAGAL: gagal: ora bisa diterusake: 42
