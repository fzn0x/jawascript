// RUN: jawac run %s | FileCheck %s

// Nyadhiyakake memori kira-kira sak gigabita, meh kabeh langsung dadi
// sampah. Tanpa pangumpul sampah memorine bakal entek; nganggo bdwgc
// memori sing isih urip tetep cilik.

wujud Simpul {
    regane: wilangan
    sabanjure: Simpul
}

gawe utama() {
    ayo dawa = 0
    kanggo i ing 0..100000 {
        // Ukara 6 KB, dibuwang ing puteran sabanjure.
        ayo s = "sampah"
        kanggo j ing 0..10 {
            s = s + s
        }
        dawa = dawane(s)
    }
    // CHECK: 6144
    tulis(dawa)

    // Dhaptar dawa tetep urip sajrone isih bisa digayuh, banjur dadi sampah.
    ayo gunggung = 0
    kanggo putaran ing 0..20 {
        ayo dhaptar: Simpul = kosong
        kanggo i ing 0..100000 {
            dhaptar = Simpul { regane: i, sabanjure: dhaptar }
        }
        ayo n = dhaptar
        sajrone n != kosong {
            gunggung += n.regane
            n = n.sabanjure
        }
    }
    // CHECK-NEXT: 99999000000
    tulis(gunggung)
}
