// RUN: jawac run %s | FileCheck %s

// Allocates about a gigabyte in total, almost all of it garbage straight
// away. Without a collector this would run out of memory; with bdwgc the
// live heap stays small.

wujud Simpul {
    regane: wilangan
    sabanjure: Simpul
}

gawe utama() {
    ayo dawa = 0
    kanggo i ing 0..100000 {
        // A 6 KB string, dropped on the next iteration.
        ayo s = "sampah"
        kanggo j ing 0..10 {
            s = s + s
        }
        dawa = dawane(s)
    }
    // CHECK: 6144
    tulis(dawa)

    // A long list survives while it is reachable, then becomes garbage.
    ayo total = 0
    kanggo putaran ing 0..20 {
        ayo dhaptar: Simpul = kosong
        kanggo i ing 0..100000 {
            dhaptar = Simpul { regane: i, sabanjure: dhaptar }
        }
        ayo n = dhaptar
        sajrone n != kosong {
            total += n.regane
            n = n.sabanjure
        }
    }
    // CHECK-NEXT: 99999000000
    tulis(total)
}
