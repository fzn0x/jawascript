// RUN: jawac run -O0 %s | FileCheck %s
// RUN: jawac run -O2 %s | FileCheck %s

gawe dicathet(teks: ukara, asil: logika) -> logika {
    tulis("  dietung", teks)
    bali asil
}

gawe golek(larik: [wilangan], sing_digoleki: wilangan) -> wilangan {
    kanggo i ing 0..dawane(larik) {
        yen larik[i] == sing_digoleki {
            bali i
        }
    }
    bali -1
}

gawe utama() {
    // `lan` lan `utawa` ora ngetung sisih tengen yen sisih kiwa wis nemtokake.
    // CHECK: salah
    // CHECK-NOT: dietung
    tulis(salah lan dicathet("tengen", bener))
    // CHECK: dietung kiwa
    // CHECK-NEXT: bener
    tulis(dicathet("kiwa", bener) utawa dicathet("tengen", salah))

    // `mandheg` lan `terusna` mung ngenani puteran sing paling jero, lan
    // `terusna` ing `kanggo` tetep nambah pangetunge.
    ayo pasangan = ""
    kanggo i ing 0..4 {
        kanggo j ing 0..4 {
            yen j == i {
                terusna
            }
            yen j > 2 {
                mandheg
            }
            pasangan += ukara(i) + ukara(j) + " "
        }
    }
    // CHECK: 01 02 10 12 20 21 30 31 32
    tulis(pasangan)

    // `bali` saka jero puteran.
    // CHECK-NEXT: 2 -1
    tulis(golek([5, 7, 9], 9), golek([5, 7, 9], 4))

    // `sajrone` sing mandheg luwih dhisik.
    ayo n = 0
    sajrone bener {
        n += 1
        yen n * n > 50 {
            mandheg
        }
    }
    // CHECK-NEXT: 8
    tulis(n)

    // Rentang sing nglebokake pungkasane, lan rentang kosong.
    ayo hitungan = 0
    kanggo i ing 1..=3 {
        hitungan += i
    }
    kanggo i ing 5..2 {
        hitungan += 100
    }
    // CHECK-NEXT: 6
    tulis(hitungan)

    // Jeneng sing nutupi jeneng liya ing blok jero.
    ayo x = 1
    {
        ayo x = "jero"
        tulis(x)
    }
    // CHECK-NEXT: jero
    // CHECK-NEXT: 1
    tulis(x)
}
