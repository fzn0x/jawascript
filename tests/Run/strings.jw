// RUN: jawac run -O0 %s | FileCheck %s --strict-whitespace
// RUN: jawac run -O2 %s | FileCheck %s --strict-whitespace

gawe sapa(jeneng: ukara) -> ukara {
    bali "sugeng enjing, " + jeneng + "!"
}

gawe utama() {
    // CHECK: sugeng enjing, Sri!
    tulis(sapa("Sri"))

    // Ukara bisa disambung karo wilangan lan logika, sing diowahi dadi ukara.
    // CHECK-NEXT: 1 + 1 = 2, bener, 2.5
    tulis("1 + 1 = " + (1 + 1) + ", " + bener + ", " + 2.5)

    // Aksara khusus.
    // CHECK-NEXT: tab:	pethik:" garis_miring:\ unikode:©
    tulis("tab:\tpethik:\" garis_miring:\\ unikode:\u{A9}")

    // Dawane diukur nganggo bita; saben aksara Jawa butuh telung bita.
    // CHECK-NEXT: 4 6 0
    tulis(dawane("Jawa"), dawane("ꦗꦮ"), dawane(""))

    // Mbandhingake miturut bita, lan padha-orane miturut isine.
    ayo a = "pe"
    ayo b = a + "lem"
    // CHECK-NEXT: bener bener salah bener bener
    tulis(b == "pelem", "apel" < "jeruk", "b" < "a", "ab" < "abc", "" < "a")

    // Nggawe ukara ing puteran.
    ayo s = ""
    kanggo i ing 0..5 {
        s += ukara(i)
    }
    // CHECK-NEXT: 01234
    tulis(s)

    // Maca wilangan saka ukara.
    // CHECK-NEXT: 42 -7 2.5 1000.0
    tulis(wilangan(" 42 "), wilangan("-7"), pecahan("2.5"), pecahan("1e3"))
}
