// RUN: jawac run -O0 %s | FileCheck %s
// RUN: jawac run -O2 %s | FileCheck %s

gawe gunggung(larik: [wilangan]) -> wilangan {
    ayo asil = 0
    kanggo x ing larik {
        asil += x
    }
    bali asil
}

gawe utama() {
    ayo larik = [3, 1, 2]
    // CHECK: [3, 1, 2] 3 6
    tulis(larik, dawane(larik), gunggung(larik))

    larik[1] = 10
    larik[0] += 1
    tambah(larik, 5)
    // CHECK-NEXT: [4, 10, 2, 5] 4
    tulis(larik, dawane(larik))

    // Larik bisa mundhak ngluwihi wadhah wiwitane.
    ayo gedhe: [wilangan] = []
    kanggo i ing 0..1000 {
        tambah(gedhe, i)
    }
    // CHECK-NEXT: 1000 999 499500
    tulis(dawane(gedhe), gedhe[999], gunggung(gedhe))

    // Larik iku referensi.
    ayo kanca = larik
    kanca[0] = 99
    // CHECK-NEXT: 99
    tulis(larik[0])

    // Puteran ing larik weruh isi sing ditambahake nalika lagi mlaku.
    ayo antrian = [1]
    kanggo x ing antrian {
        yen x < 4 {
            tambah(antrian, x + 1)
        }
    }
    // CHECK-NEXT: [1, 2, 3, 4]
    tulis(antrian)

    // Saben jinis isi sing bisa ditulis, lan larik isi larik.
    // CHECK-NEXT: [1.5, 2.0] [bener, salah] ["a", "b\"c"] []
    ayo kosongan: [ukara] = []
    tulis([1.5, 2], [bener, salah], ["a", "b\"c"], kosongan)
    ayo kothak = [[1, 2], [3, 4]]
    kothak[1][0] = 30
    // CHECK-NEXT: [30, 4] 2
    tulis(kothak[1], dawane(kothak))
}
