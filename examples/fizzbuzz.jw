// FizzBuzz ditabuh nganggo gamelan: kelipatan 3 nabuh gong, kelipatan 5
// nabuh kendhang, lan kelipatan loro-lorone nabuh kabeh.

gawe utama() {
    kanggo (ayo n = 1; n <= 20; n++) {
        yen (n % 15 === 0) {
            tulis("Gong Kendhang")
        } liyane yen (n % 3 === 0) {
            tulis("Gong")
        } liyane yen (n % 5 === 0) {
            tulis("Kendhang")
        } liyane {
            tulis(n)
        }
    }
}
