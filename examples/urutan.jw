// Ngurutake larik ing panggonane dhewe nganggo quicksort.

gawe ijolan(larik: wilangan[], i: wilangan, j: wilangan) {
    tetep sauntara = larik[i]
    larik[i] = larik[j]
    larik[j] = sauntara
}

gawe pisah(larik: wilangan[], kiwa: wilangan, tengen: wilangan): wilangan {
    tetep poros = larik[tengen]
    ayo i = kiwa
    kanggo j ing kiwa..tengen {
        yen larik[j] < poros {
            ijolan(larik, i, j)
            i += 1
        }
    }
    ijolan(larik, i, tengen)
    bali i
}

gawe ngurutake(larik: wilangan[], kiwa: wilangan, tengen: wilangan) {
    yen kiwa >= tengen {
        bali
    }
    tetep p = pisah(larik, kiwa, tengen)
    ngurutake(larik, kiwa, p - 1)
    ngurutake(larik, p + 1, tengen)
}

gawe wis_urut(larik: wilangan[]): logika {
    kanggo i ing 1..dawane(larik) {
        yen larik[i - 1] > larik[i] {
            bali salah
        }
    }
    bali bener
}

gawe utama() {
    ayo angka = [38, 27, 43, 3, 9, 82, 10, -5, 27, 0]
    tulis("sadurunge:", angka)
    ngurutake(angka, 0, dawane(angka) - 1)
    tulis("sawise:   ", angka)
    tulis("wis urut?", wis_urut(angka))
}
