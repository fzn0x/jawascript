// Hanacaraka: aksara Jawa lan crita ing sangisore rong puluh aksarane.
// Ukara nganggo UTF-8, mula aksara Jawa bisa ditulis apa anane.

gawe utama() {
    tetep aksara = [
        "ꦲ", "ꦤ", "ꦕ", "ꦫ", "ꦏ",
        "ꦢ", "ꦠ", "ꦱ", "ꦮ", "ꦭ",
        "ꦥ", "ꦝ", "ꦗ", "ꦪ", "ꦚ",
        "ꦩ", "ꦒ", "ꦧ", "ꦛ", "ꦔ",
    ]
    tetep latin = [
        "ha", "na", "ca", "ra", "ka",
        "da", "ta", "sa", "wa", "la",
        "pa", "dha", "ja", "ya", "nya",
        "ma", "ga", "ba", "tha", "nga",
    ]
    tetep tegese = [
        "ana utusan loro",
        "padha pasulayan",
        "padha digdayane",
        "padha dadi bathang",
    ]

    kanggo baris ing 0..4 {
        ayo tulisan = ""
        ayo waosan = ""
        kanggo kolom ing 0..5 {
            tetep i = baris * 5 + kolom
            tulisan += aksara[i]
            waosan += latin[i] + " "
        }
        tulis(tulisan, waosan + "- " + tegese[baris])
    }

    tetep jeneng = "ꦗꦮ"
    tulis(jeneng, "(jawa) dawane", dawane(jeneng), "bita UTF-8")
}
