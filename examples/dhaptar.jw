// Wujud lan dhaptar sambung: saben simpul nuding simpul sabanjure.

wujud Titik {
    x: pecahan
    y: pecahan
}

wujud Simpul {
    regane: wilangan
    sabanjure: Simpul
}

gawe jarak_kuadrat(a: Titik, b: Titik): pecahan {
    tetep bedane_x = a.x - b.x
    tetep bedane_y = a.y - b.y
    bali bedane_x * bedane_x + bedane_y * bedane_y
}

// Nggawe dhaptar 1 -> 2 -> ... -> n, pungkasane `kosong`.
gawe gawe_dhaptar(n: wilangan): Simpul {
    ayo sirah: Simpul = kosong
    ayo i = n
    sajrone i > 0 {
        sirah = Simpul { regane: i, sabanjure: sirah }
        i -= 1
    }
    bali sirah
}

gawe gunggung(dhaptar: Simpul): wilangan {
    ayo asil = 0
    ayo simpul = dhaptar
    sajrone simpul != kosong {
        asil += simpul.regane
        simpul = simpul.sabanjure
    }
    bali asil
}

gawe utama() {
    tetep omah = Titik { x: 1.5, y: 2 }
    tetep pasar = Titik { x: 4.5, y: 6 }
    tulis("jarak kuadrat:", jarak_kuadrat(omah, pasar))

    tetep dhaptar = gawe_dhaptar(10)
    tulis("simpul kapisan:", dhaptar.regane, "sabanjure:", dhaptar.sabanjure.regane)
    tulis("gunggung 1..10:", gunggung(dhaptar))

    // Wujud iku referensi: jeneng loro-lorone weruh owah-owahane.
    ayo kancane = omah
    kancane.x = 100
    tulis("omah.x saiki", omah.x)
}
